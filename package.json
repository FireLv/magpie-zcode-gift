{
  "name": "zcode-gift",
  "version": "0.2.0",
  "description": "ZCode 礼包助手（magpie 插件）：自动识别并领取 ZCode 礼包，跨账号汇总持有/用量/领取记录。账号来自 magpie 的 zcode 供应商登录。",
  "type": "module",
  "main": "./index.mjs",
  "files": [
    "index.mjs",
    "server.mjs",
    "runner.mjs",
    "claim.mjs",
    "sweep.mjs",
    "lib",
    "page",
    "tools",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FireLv/magpie-zcode-gift.git"
  },
  "homepage": "https://github.com/FireLv/magpie-zcode-gift",
  "keywords": [
    "magpie",
    "magpie-plugin",
    "zcode",
    "gift",
    "claim",
    "page"
  ],
  "license": "MIT",
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "page": {
      "title": "ZCode 礼包",
      "titles": {
        "zh": "ZCode 礼包",
        "en": "ZCode Gifts"
      },
      "file": "page/index.html",
      "icon": "page/icon.svg",
      "service": {
        "port": 3455,
        "option": "port"
      }
    },
    "options": {
      "port": 3455
    }
  }
}
